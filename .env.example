# Application Environment
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://ecommerce_user:ecommerce_secure_password@localhost:5432/ecommerce_db?schema=public"

# Cache & Concurrency (Redis)
# Format: redis://:PASSWORD@HOST:PORT
REDIS_URL="redis://:redis_secure_password@localhost:6379"

# NextAuth / Session Security
# Generate 32-byte secret using: openssl rand -base64 32
NEXTAUTH_SECRET="change-this-to-a-secure-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Background Worker & Cron Security (Optional)
CRON_SECRET="change-this-to-a-secure-cron-token"

# Pluggable Payment Engine Configuration
# Supported providers: MOCK | RAZORPAY
# Default is MOCK (zero credentials required for local development and CI testing)
PAYMENT_PROVIDER="MOCK"

# Razorpay Credentials (required only when PAYMENT_PROVIDER=RAZORPAY)
RAZORPAY_KEY_ID="rzp_test_placeholder_key_id"
RAZORPAY_KEY_SECRET="placeholder_secret_key"
RAZORPAY_WEBHOOK_SECRET="placeholder_webhook_secret"

# GST & Taxation Configuration (India)
# Operating origin state for GST calculation (Intra-state: CGST+SGST, Inter-state: IGST)
STORE_STATE="Chhattisgarh"

# Transactional Email (Optional for development)
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="orders@example.in"
EMAIL_SERVER_PASSWORD="smtp_password"
EMAIL_FROM="orders@example.in"
